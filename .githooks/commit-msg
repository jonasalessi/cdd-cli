#!/bin/sh
# Validates commit message format: <type>: <description>
# Allowed types: feat|fix|refactor|perf|docs|test|build|ci

msg_file="$1"
first_line=$(grep -v '^#' "$msg_file" | sed -n '1p')

# Allow merge/revert/fixup commits generated by git
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|refactor|perf|docs|test|build|ci): [^ ].*$'; then
  echo "ERROR: invalid commit message:" >&2
  echo "  \"$first_line\"" >&2
  echo >&2
  echo "Expected format: <type>: <description>" >&2
  echo "Allowed types:   feat|fix|refactor|perf|docs|test|build|ci" >&2
  echo "Example:         feat: add init command" >&2
  exit 1
fi

if grep -Eq '^Co-Authored-By:' "$msg_file"; then
  echo "ERROR: commit message must not contain a Co-Authored-By trailer" >&2
  exit 1
fi
